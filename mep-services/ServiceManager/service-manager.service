[Unit]
Description=MEP System Service Manager
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
ExecStart=/opt/radioconda/bin/python -B /opt/ansible/mep-services/ServiceManager/service_manager.py
Environment=PYTHONUNBUFFERED=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
