[Unit]
Description=Analog Frontend controller service
BindsTo=dev-ttyGNSS1.device
After=dev-ttyGNSS1.device
Wants=gpsd.service
After=gpsd.service

[Service]
Type=exec
ExecStart=/opt/radioconda/bin/python /opt/ansible/mep-services/AFEControl/afe_control.py
User=mep
Group=mep
Restart=always

[Install]
WantedBy=multi-user.target
